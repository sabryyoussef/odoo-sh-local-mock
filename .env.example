# Copy to .env and fill in values from a GitHub OAuth App.
# Never commit .env.

SESSION_SECRET=replace-with-a-long-random-string

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Primary callback when using the public tunnel (Windows / remote browsers):
GITHUB_CALLBACK_URL=https://mock-odoo.drpaws.ai/auth/github/callback
# Local-only dev (register BOTH in GitHub OAuth App callback URLs):
# GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
# Also register: http://127.0.0.1:8000/auth/github/callback

# Optional override (default inside Docker: sqlite:////data/control.db)
# DATABASE_URL=sqlite:////data/control.db

# REQUIRED for operator portal/API (comma-separated GitHub logins). Empty = fail closed.
# Use your exact GitHub username (login), not display name — verify via /user API after login.
OPERATOR_GITHUB_LOGINS=your-github-login

# --- Phase 8 tenant provisioning worker ---
TENANT_ROOT=/data/tenants
TENANT_HOST_ROOT=/opt/projects/active/odoo-sh-local-mock/data/tenants
TENANT_PORT_MIN=8201
TENANT_PORT_MAX=8298
PROVISIONING_WORKER_POLL_SEC=5
PROVISIONING_MAX_ATTEMPTS=3
PROVISIONING_WORKER_ID=provisioning-worker-1

# --- Phase 9 customer portal ---
# Public tenant URL base for Phase 12 routing (leave empty for localhost-only MVP)
TENANT_PUBLIC_BASE_URL=
# Show localhost launch links only when request is from local/dev network
TENANT_ALLOW_LOCALHOST_LAUNCH=true

# --- Phase 10 backup / restore / quotas ---
BACKUP_ROOT=/data/backups
BACKUP_HOST_ROOT=/opt/projects/active/odoo-sh-local-mock/data/backups
BACKUP_WORKER_POLL_SEC=10
BACKUP_MAX_ATTEMPTS=3
BACKUP_WORKER_ID=backup-worker-1
# Optional encryption-at-rest key (leave empty for permissions-only MVP)
# BACKUP_ENCRYPTION_KEY=
QUOTA_WARNING_THRESHOLD=0.8
BACKUP_SCHEDULE_RETRY_MINUTES=15

# Demo presentation branding: default | helpers_erp
DEMO_THEME=helpers_erp


# --- FIRST_REAL_ODOO_BUILD_ENGINE ---
# Control plane remains SQLite. Odoo runtime DBs use shared PostgreSQL.
BUILD_ROOT=/data/builds
BUILD_HOST_ROOT=/opt/projects/active/odoo-sh-local-mock/data/builds
BUILD_PORT_MIN=8101
# Host already uses 8199 for an unrelated service — keep max at 8198.
BUILD_PORT_MAX=8198
BUILD_POSTGRES_HOST=build-postgres
BUILD_POSTGRES_PORT=5432
BUILD_POSTGRES_ADMIN_USER=mosh_admin
BUILD_POSTGRES_ADMIN_PASSWORD=replace-with-strong-password
BUILD_POSTGRES_USER=mosh_odoo
BUILD_POSTGRES_PASSWORD=replace-with-strong-password
# Official Community images (not Enterprise).
ODOO19_IMAGE=odoo:19.0
ODOO18_IMAGE=odoo:18.0
ODOO17_IMAGE=odoo:17.0
BUILD_DOCKER_NETWORK=odoo-sh-local-mock_default
BUILD_CONTAINER_MEMORY=1536m
BUILD_CONTAINER_NANO_CPUS=1000000000
BUILD_HEALTH_TIMEOUT_SEC=180

# --- REAL_BUILD_LIFECYCLE_AND_GITHUB_WEBHOOKS ---
# Independent of GITHUB_CLIENT_SECRET / SESSION_SECRET.
GITHUB_WEBHOOK_SECRET=replace-with-long-random-webhook-hmac-secret
# Must be reachable by github.com (not localhost). Example Cloudflare tunnel host:
GITHUB_WEBHOOK_PUBLIC_URL=https://mock-odoo.drpaws.ai/webhooks/github
MAX_CONCURRENT_BUILDS=2
