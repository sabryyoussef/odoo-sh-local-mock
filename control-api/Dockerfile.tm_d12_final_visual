FROM odoo-sh-local-mock-control-api:latest

RUN pip install --no-cache-dir playwright passlib cryptography==44.0.0 psycopg2-binary==2.9.10

COPY test_tm_d12_final_visual.py /app/test_tm_d12_final_visual.py

RUN apt-get update && apt-get install -y --no-install-recommends fonts-liberation libasound2 libatk-bridge2.0-0 libatk1.0-0 libcups2 libdbus-1-3 libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 xdg-utils && rm -rf /var/lib/apt/lists/*

RUN playwright install chromium --with-deps

ENTRYPOINT ["python3", "/app/test_tm_d12_final_visual.py"]
