# FreePool — freellmpool proxy (Docker)
# Copy to .env and fill keys you obtained legitimately (one account per provider ToS).

FREEPOOL_PROXY_KEY=dev-local-key
FREELLMPOOL_ROUTING=spread

# Optional provider keys (same names as freellmpool)
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
